PORT=4000
NODE_ENV=development
# Local primary store — read by Prisma (sqlite provider)
SQLITE_URL="file:./dev.db"
# Supabase Postgres — read by src/lib/db.js (mirror writes + schema DDL).
# Free-tier direct host db.<ref>.supabase.co is IPv6-only: on an IPv4-only
# network use the shared pooler instead, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (transaction mode = port 6543 + prepare:false; session mode = port 5432).
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CLIENT_ORIGIN="http://localhost:3000"
DEMO_PASSWORD="SafarDesk@2026"
UPLOAD_DIR="./uploads"

# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional override for the DSN above, plus the Management API alternative
# (DDL needs more than an API key: a DSN or a personal access token).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_ACCESS_TOKEN=sbp_...
